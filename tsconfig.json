{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,

        "module": "ESNext",
        "moduleResolution": "Bundler",

        "jsx": "react-jsx",

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "strict": false,
        "noImplicitAny": false,

        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true
    },

    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts"
    ],

    "exclude": [
        "node_modules",
        "vendor"
    ]
}